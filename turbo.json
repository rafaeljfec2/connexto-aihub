{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#dev:backend": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "check": {
      "dependsOn": ["^check"]
    }
  }
}
