# AI Hub configuration. This file and the process environment are the only
# configuration sources: config.json no longer exists.
# Copy to .env and adjust. Values already present in the real environment win.
# Never commit the resulting .env file.

# HTTP server
AIHUB_SERVER_HOST=127.0.0.1
AIHUB_SERVER_PORT=8080
AIHUB_SERVER_READ_HEADER_TIMEOUT=5s
AIHUB_SERVER_READ_TIMEOUT=1h
AIHUB_SERVER_WRITE_TIMEOUT=12h
AIHUB_SERVER_IDLE_TIMEOUT=12h
AIHUB_SERVER_SHUTDOWN_TIMEOUT=10s

# Logging
AIHUB_LOG_LEVEL=info
AIHUB_LOG_FORMAT=json
# json	 Padrão. Uma linha JSON por evento, para máquinas e produção.
# text	 Formato key=value da biblioteca padrão do Go (slog).
# pretty Formato legível para desenvolvimento, com cores em terminal.
AIHUB_LOG_FORMAT=pretty

# Provider integration (E02). Without a key the provider stays disabled and AI
# Hub boots normally; the gateway then answers 503 and readiness is unaffected.
AIHUB_PROVIDER_OPENCODEGO_BASE_URL=https://opencode.ai/inference/go
# AIHUB_PROVIDER_OPENCODEGO_API_KEY=oc_sk_

# Connexto Proxy CLI LLMs integration (Cursor models via local proxy).
AIHUB_PROVIDER_CONNEXTO_PROXY_BASE_URL=http://127.0.0.1:9090/v1
# AIHUB_CONNEXTO_PROXY_GATEWAY_KEY=docker-local-gateway-dev
# When using Docker for the proxy, rebuild the gateway image after upgrades so
# GATEWAY_JSON_BODY_LIMIT_BYTES (default 32 MiB) applies. Direct proxy clients can mount one repo at
# /workspace with CURSOR_DEFAULT_WORKING_DIRECTORY=/workspace (see docker-compose.yml and apps/proxy).
# Hub + Codex requests take workspace from the payload only (absolute host paths). For multi-repo Docker,
# bind-mount the host at the same absolute paths (e.g. /home/rafael:/home/rafael:rw) or run `pnpm dev` on the host.
# After hub upgrades that change modality normalization (E03 amendment A2), sync catalog for
# cursor, openrouter, and opencode-go (POST /v1/catalog/sync) and verify image_input on vision models, e.g.:
# GET /v1/catalog/models/cursor/composer-2.5 → capabilities.image_input.state=supported
# Text-only models on the proxy must declare modalities.input=["text"] so defaults are not applied (SPEC §5.4).

# Gateway access control (E04). The API key is mandatory for every startup,
# including loopback. Use a value distinct from the provider key: 32-512
# characters from [A-Za-z0-9._~+/-] with optional trailing '=' padding.
# Leave it empty here and set a private value in .env; for example:
#   openssl rand -base64 48
AIHUB_GATEWAY_API_KEY=

# Required only when AIHUB_SERVER_HOST is non-loopback. Comma-separated exact
# DNS names or IP literals, without ports, schemes, paths or wildcards.
# AIHUB_GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional exact browser origins. Empty means no Origin header is accepted from
# a browser; non-browser requests without Origin remain allowed.
# AIHUB_GATEWAY_ALLOWED_ORIGINS=

# Request body bound for protected POST routes. Default 32 MiB; range 1 KiB to
# 128 MiB. Catalog sync keeps its own 4 KiB cap.
# AIHUB_GATEWAY_MAX_BODY_BYTES=33554432

# Model catalog (E03). The data directory defaults to
# ${XDG_DATA_HOME:-$HOME/.local/share}/ai-hub and must be absolute when set.
AIHUB_DATA_DIR=
AIHUB_CATALOG_STALE_AFTER=24h
AIHUB_CATALOG_SYNC_TIMEOUT=10s

# Execution records (E06). Append-only JSONL segments live under
# ${AIHUB_DATA_DIR}/records and are trimmed on the retention interval.
# Limits are validated at startup; see the README for the accepted ranges.
# AIHUB_RECORDS_MAX_AGE=720h
# AIHUB_RECORDS_MAX_COUNT=10000
# AIHUB_RECORDS_MAX_STORAGE_BYTES=134217728
# AIHUB_RECORDS_SEGMENT_BYTES=8388608
# AIHUB_RECORDS_RETENTION_INTERVAL=1h

# PostgreSQL persistence foundation (Phase B, ADR-020). Empty (default)
# keeps the local-first JSON snapshot file; a URL-form postgres DSN opts the
# catalog persistence into PostgreSQL, adds startup migrations (fail fast)
# and a database readiness check. URL form only. The DSN is redacted in logs
# and errors; keep the password in .env, never in shell history.
# AIHUB_DATABASE_URL=postgres://user:password@127.0.0.1:5432/ai_hub
# AIHUB_DATABASE_MAX_CONNS=4
# AIHUB_DATABASE_MIN_CONNS=0
# AIHUB_DATABASE_CONNECT_TIMEOUT=5s
# AIHUB_CATALOG_PERSISTENCE=file|postgres (default: postgres when a URL is set)
#
# UI sign-in: when a database URL is configured (postgres persistence), the UI
# uses email/password (no separate auth mode flag). Set a 32+ byte session secret
# and either AIHUB_BOOTSTRAP_ADMIN_PASSWORD or AIHUB_OPERATOR_PASSPHRASE to create
# the first admin on an empty users table (default email rafaeljfec2@gmail.com,
# override with AIHUB_BOOTSTRAP_ADMIN_EMAIL).
# AIHUB_UI_SESSION_SECRET=
# AIHUB_BOOTSTRAP_ADMIN_PASSWORD=
